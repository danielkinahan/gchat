FROM archlinux:latest

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8

WORKDIR /app

# Install build tools and dependencies
RUN pacman -Syu --noconfirm && \
    pacman -S --needed --noconfirm git base-devel sudo curl

# Create non-root builder user (required for AUR)
RUN useradd -m builder && \
    echo "builder ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# Build discord-chat-exporter-bin from AUR
USER builder
WORKDIR /tmp

RUN git clone https://aur.archlinux.org/yay-bin.git && \
    cd yay-bin && \
    makepkg -si --noconfirm

RUN yay -S --noconfirm discord-chat-exporter-cli-bin signalbackup-tools-git supercronic-bin

USER root

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY scripts/scheduler ./scripts/scheduler

RUN python -m venv /app/.venv && \
    /app/.venv/bin/pip install --no-cache-dir . && \
    chmod +x /app/scripts/scheduler/*.sh

ENV PATH="/app/.venv/bin:$PATH"

CMD ["sh", "/app/scripts/scheduler/entrypoint.sh"]
